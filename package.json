{
    "name": "dpuse-kb",
    "version": "0.0.41",
    "private": true,
    "description": "The DPUse knowledge base — documentation source and ingestion scripts.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-kb/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-kb.git"
    },
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "scripts": {
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "fetch-connectors": "node scripts/fetch-connectors.ts",
        "ingest": "npm run fetch-connectors && op run --env-file=.env -- node scripts/ingest.ts",
        "ingest:kv": "npm run fetch-connectors && op run --env-file=.env -- node scripts/ingest.ts --kv-only",
        "kv-test": "op run --env-file=.env -- node scripts/kvTest.ts",
        "search": "op run --env-file=.env -- node scripts/search.ts",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "type-check": "tsc --noEmit",
        "site:dev": "npm run dev --prefix site",
        "site:build": "npm run ingest:kv && npm run build --prefix site",
        "site:deploy": "npm run ingest:kv && npm run deploy --prefix site"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^0.3.816",
        "@dpuse/dpuse-shared": "^0.3.869",
        "@types/node": "^26.6.4",
        "gray-matter": "^4.0.3",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3"
    }
}
