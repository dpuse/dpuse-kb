{
    "name": "dpuse-kb",
    "version": "1.0.4",
    "private": false,
    "description": "The DPUse knowledge base — documentation source and ingestion scripts.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "type": "module",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-kb/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-kb.git"
    },
    "workspaces": [
        "site"
    ],
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.21.5": true,
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20261001.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "build": "npm run connectorsFetch && npm run build --workspace site",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkProject())\"",
        "cloudflareAISearchKVIngest": "npm run connectorsFetch && op run --env-file=.env -- node scripts/cloudflareAISearchKVIngest.ts",
        "cloudflareAISearchKVIngest:kvOnly": "npm run connectorsFetch && op run --env-file=.env -- node scripts/cloudflareAISearchKVIngest.ts --kv-only",
        "connectorsFetch": "node scripts/connectorsFetch.ts",
        "deploy": "node scripts/cloudflareAISearchKVIngest.ts --kv-only && npm run deploy --workspace site",
        "document": "node -e \"import('@dpuse/dpuse-development').then(m => m.documentProject('MIT'))\"",
        "format": "node -e \"import('@dpuse/dpuse-development').then(m => m.formatCode())\"",
        "lint": "node -e \"import('@dpuse/dpuse-development').then(m => m.lintCode())\"",
        "release": "npm run build && npm run document && npm run sync && node -e \"import('@dpuse/dpuse-development').then(m => m.triggerGitHubRelease())\"",
        "site:dev": "npm run dev --workspace site",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "test": "node -e \"import('@dpuse/dpuse-development').then(m => m.testProject())\"",
        "testKV": "op run --env-file=.env -- node scripts/testKV.ts",
        "testSearch": "op run --env-file=.env -- node scripts/testSearch.ts",
        "type-check": "tsc --noEmit"
    },
    "devDependencies": {
        "@dpuse/dpuse-development": "^1.0.4",
        "@dpuse/dpuse-shared": "^1.0.2",
        "@dpuse/eslint-config-dpuse": "^1.0.131",
        "@types/node": "^26.6.4",
        "eslint": "^10.12.0",
        "gray-matter": "^4.0.3",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3"
    }
}
