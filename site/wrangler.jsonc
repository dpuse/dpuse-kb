{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "dpuse-site",
    "compatibility_date": "2026-06-17",
    "assets": {
        "directory": ".vitepress/dist"
    },
    "routes": [{ "custom_domain": true, "pattern": "www.dpuse.app", "zone_name": "dpuse.app" }],
    "observability": {
        "enabled": true
    },
    "workers_dev": true
}
